{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.24.0"
  },
  "extensions": [
    {
      "name": "action-buttons",
      "component": "actionBarButtons",
      "slot": "mortuary-action-buttons-slot",
      "meta": {
        "fullWidth": false,
        "privileges": [
          "o3 : View Mortuary Dashboard",
          "o3 : Admit Body to Mortuary",
          "o3 : Edit Mortuary Records",
          "o3 : Discharge Body from Mortuary",
          "o3 : View Mortuary Compartments",
          "o3 : Swap Mortuary Compartments",
          "o3 : View Mortuary Billing",
          "o3 : Process Mortuary Payments",
          "o3 : View Mortuary Reports",
          "o3 : Generate Mortuary Reports"
        ]
      }
    },
    {
      "name": "deceased-banner-info",
      "component": "bannerInfo",
      "slot": "deceased-banner-info-slot",
      "meta": {
        "fullWidth": false
      }
    },
    {
      "name": "print-post-mortem-overflow-menu-item",
      "component": "printPostMortemOverflowMenuItem",
      "slot": "print-post-mortem-overflow-menu-item-slot"
    },
    {
      "component": "root",
      "name": "morgue-dashboard-root",
      "slot": "morgue-dashboard-slot",
      "meta": {
        "privileges": [
          "o3 : View Mortuary Dashboard"
        ]
      }
    },
    {
      "component": "mortuaryDashboardLink",
      "name": "mortuary-dashboard-link",
      "slot": "homepage-dashboard-slot",
      "privileges": [
        "O3 View Mortuary Dashboard"
      ],
      "meta": {
        "name": "mortuary",
        "slot": "mortuary-dashboard-slot",
        "title": "Mortuary"
      }
    },
    {
      "name": "morgue-dashboard",
      "component": "morgueDashboard",
      "slot": "mortuary-dashboard-slot",
      "privileges": [
        "O3 View Mortuary Dashboard"
      ]
    },
    {
      "slot": "system-admin-page-card-link-slot",
      "component": "morgueAdministrationCardLink",
      "name": "morgue-admin-card-link"
    },
    {
      "name": "storage-units-left-panel-link",
      "component": "storageUnitsLeftPanelLink",
      "slot": "morgue-management-left-panel-slot",
      "order": 1
    },
    {
      "name": "compartments-left-panel-link",
      "component": "compartmentsLeftPanelLink",
      "slot": "morgue-management-left-panel-slot",
      "order": 2
    }
  ],
  "workspaceGroups2": [
    {
      "name": "morgue-operations-workspace-group",
      "persistence": "closable",
      "scopePattern": "^/home/morgue"
    },
    {
      "name": "morgue-management-workspace-group",
      "persistence": "closable",
      "scopePattern": "^/morgue-management"
    }
  ],
  "workspaceWindows2": [
    {
      "name": "morgue-operations-workspace-window",
      "group": "morgue-operations-workspace-group",
      "width": "narrow"
    },
    {
      "name": "morgue-form-entry-workspace-window",
      "group": "morgue-operations-workspace-group",
      "width": "extra-wide"
    },
    {
      "name": "morgue-management-workspace-window",
      "group": "morgue-management-workspace-group",
      "width": "narrow"
    }
  ],
  "workspaces2": [
    {
      "name": "discharge-body-form",
      "component": "dischargeBodyForm",
      "window": "morgue-operations-workspace-window"
    },
    {
      "name": "swap-unit-form",
      "component": "swapForm",
      "window": "morgue-operations-workspace-window"
    },
    {
      "name": "admit-deceased-person-form",
      "component": "admitDeceasedPersonForm",
      "window": "morgue-operations-workspace-window"
    },
    {
      "name": "mark-person-deceased-form",
      "component": "markPersonDeceasedForm",
      "window": "morgue-operations-workspace-window"
    },
    {
      "name": "mortuary-form-entry",
      "component": "mortuaryFormEntry",
      "window": "morgue-form-entry-workspace-window"
    },
    {
      "name": "storage-unit-form",
      "component": "storageUnitForm",
      "window": "morgue-management-workspace-window"
    },
    {
      "name": "compartment-form",
      "component": "compartmentForm",
      "window": "morgue-management-workspace-window"
    }
  ],
  "modals": [
    {
      "name": "print-confirmation-modal",
      "component": "printConfirmationModal"
    },
    {
      "name": "autopsy-report-modal",
      "component": "autopsyReportModal"
    }
  ],
  "pages": [
    {
      "component": "root",
      "route": "morgue"
    },
    {
      "component": "morgueManagementHome",
      "route": "morgue-management"
    }
  ]
}